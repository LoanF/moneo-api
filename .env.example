# ── Base de données ──────────────────────────────────────────────────────────
POSTGRES_USER=moneo_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=moneo_db
DB_HOST=db
DB_PORT=5432
# DB_SSL=true            # pour une base managée exigeant TLS
# DATABASE_URL=postgres://user:pass@host:5432/db   # remplace les variables ci-dessus

# ── Sécurité ─────────────────────────────────────────────────────────────────
# 32 caractères minimum en production. Générer avec : openssl rand -base64 48
ACCESS_TOKEN_SECRET=change-me-at-least-32-characters-long
# Origines navigateur autorisées (CORS), séparées par des virgules. Vide = aucune (app mobile seule).
ALLOWED_ORIGINS=
# À mettre à true UNIQUEMENT derrière un reverse proxy qui écrit X-Forwarded-For (nginx, Traefik…).
TRUST_PROXY=false

# ── Application ──────────────────────────────────────────────────────────────
APP_TIMEZONE=Europe/Paris
PUBLIC_API_URL=https://moneo-app.com/api/v1
# ENABLE_API_DOCS=true   # expose Swagger UI sur /api-docs en production
# LOG_LEVEL=info

# ── Connexion Google ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ── Emails (Brevo) : vérification d'adresse et réinitialisation de mot de passe ──
BREVO_API_KEY=
SMTP_FROM=noreply@moneo-app.com

# ── Stockage des avatars (Cloudflare R2) ─────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=moneo-assets
R2_PUBLIC_URL=

# ── Notifications push (Firebase Admin) : JSON du compte de service, sur une ligne ──
FIREBASE_SERVICE_ACCOUNT=

# ── Supervision ──────────────────────────────────────────────────────────────
UPTIME_PUSH_URL=
SENTRY_DSN=
