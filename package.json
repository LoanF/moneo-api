{
  "name": "moneo-api",
  "packageManager": "pnpm@10.18.0",
  "version": "1.5.8",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --inspect=0.0.0.0:9229 src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1115.0",
    "@hono/node-server": "^2.0.10",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.1",
    "@sentry/node": "^10.70.0",
    "fflate": "^0.8.3",
    "firebase-admin": "^13.10.0",
    "google-auth-library": "^10.9.1",
    "hono": "^4.13.3",
    "node-cron": "^4.6.0",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "pino": "^9.6.0",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "zod": "^4.6.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "esbuild",
      "protobufjs",
      "@embedded-postgres/windows-x64",
      "@embedded-postgres/linux-x64",
      "@embedded-postgres/darwin-arm64",
      "@embedded-postgres/darwin-x64",
      "@embedded-postgres/linux-arm64"
    ],
    "overrides": {
      "protobufjs": ">=7.6.1",
      "fast-xml-parser": ">=5.5.6",
      "@grpc/grpc-js": ">=1.14.5",
      "websocket-driver": ">=0.7.5",
      "form-data": ">=2.5.6",
      "underscore": ">=1.13.8",
      "minimatch@9": ">=9.0.7",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@5": ">=5.0.11",
      "picomatch@4": ">=4.0.4",
      "vite@7": ">=7.3.5",
      "lodash": ">=4.18.0",
      "js-cookie": ">=3.0.7",
      "nanoid": ">=3.3.18",
      "uuid": ">=11.1.1",
      "@tootallnate/once": ">=2.0.1",
      "yaml": ">=2.8.3",
      "handlebars": ">=4.7.10",
      "brace-expansion@2": "^2.1.6",
      "@fastify/busboy": ">=3.2.1",
      "source-map-js": ">=1.2.2",
      "vite@8": ">=8.2.4",
      "tinypool": ">=2.1.2"
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/node-cron": "^3.0.11",
    "@vitest/coverage-v8": "^3.2.7",
    "embedded-postgres": "18.6.0-beta.19",
    "pino-pretty": "^13.0.0",
    "standard-version": "^9.5.0",
    "tsx": "^4.23.10",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.10"
  }
}
